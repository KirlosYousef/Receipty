OPENROUTER_API_KEY=your-openrouter-key
MODEL=google/gemini-3.1-flash-lite
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: cap tool-calling rounds for POST /v1/agent (default 8).
# MAX_AGENT_STEPS=8
# Optional: seconds allowed for one agent run or resume (default 60).
# MAX_AGENT_SECONDS=60
# Optional: JSONL path for chat, retrieval, and tool spans (default logs/traces.jsonl).
# TRACE_LOG_PATH=logs/traces.jsonl
# Optional: how many embedding vectors to keep in memory (default 256, 0 disables).
# EMBEDDING_CACHE_SIZE=256
# Optional: use Postgres instead of SQLite. Leave empty for local SQLite.
# DATABASE_URL=postgres://receipty:receipty@localhost:5432/receipty
